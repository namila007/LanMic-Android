---
import { requirements as r } from '../content/copy';
---

<section id="requirements" aria-labelledby="req-h" class="req">
  <div class="wrap">
    <h2 id="req-h">{r.title}</h2>
    <dl class="reveal">
      {r.items.map(([k, v]) => <div class="card"><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <p class="muted note">{r.note}</p>
  </div>
</section>

<style>
  .req { padding-block: clamp(40px, 6vw, 72px); }
  h2 { font-size: clamp(28px, 4vw, 44px); margin-bottom: var(--space-6); }
  dl { margin: 0; display: grid; gap: var(--space-4); }
  dt { color: var(--brand); font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  dd { margin: 6px 0 0; font: 600 20px/28px var(--font-body); }
  .card { padding: var(--space-6); }
  .note { margin-top: var(--space-4); }
  @media (min-width: 820px) { dl { grid-template-columns: repeat(3, 1fr); } }
</style>
