---
import { Image } from 'astro:assets';
import tvShot from '../assets/tv-stats.png';
import phoneShot from '../assets/phone-stats.png';
import { features, featureRows as R } from '../content/copy';

// Deterministic fake waveform: two spoken phrases with quiet gaps (noise floor).
const bars = Array.from({ length: 40 }, (_, i) => {
  const voice = (i >= 4 && i <= 14) || (i >= 23 && i <= 34);
  const loud = 35 + Math.round(55 * Math.abs(Math.sin(i * 1.7)));
  return { raw: voice ? loud : 14 + (i % 3) * 5, gated: voice ? loud : 3, d: (i % 7) * 0.12 };
});
---

<section id="features" aria-labelledby="feat-h">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{features.eyebrow}</span>
      <h2 id="feat-h">{features.title}</h2>
    </div>

    <div class="rows">
      <!-- 1 latency -->
      <article class="row reveal">
        <div class="txt"><h3>{R[0].h}</h3>{R[0].p.map((t) => <p class="muted">{t}</p>)}</div>
        <div class="vis card">
          <p class="count mono"><span class="num" aria-hidden="true"></span><span class="sr">75</span> ms</p>
          <div class="seg" role="img" aria-label="Delay split: phone about 7 ms, Wi-Fi about 6 ms, TV jitter buffer about 20 ms, TV output about 42 ms">
            <i style="flex:7"><b>Phone ~7</b></i><i style="flex:6"><b>Wi-Fi ~6</b></i><i style="flex:20"><b>TV buffer ~20</b></i><i style="flex:42"><b>TV output ~42</b></i>
          </div>
          <div class="stat">
            <span class="muted">Delay</span><b>about 73 ms</b><span class="chip good">Good</span>
            <span class="muted">Network</span><b>11 ms</b><i></i>
            <span class="muted">Lost audio</span><b>0.0%</b><i></i>
          </div>
        </div>
      </article>

      <!-- 2 noise gate -->
      <article class="row flip reveal">
        <div class="txt"><h3>{R[1].h}</h3>{R[1].p.map((t) => <p class="muted">{t}</p>)}</div>
        <div class="vis card">
          <p class="mono lab">Without gate</p>
          <div class="wave">{bars.map((b) => <i style={`--h:${b.raw};--d:${b.d}s`}></i>)}</div>
          <p class="mono lab">With gate</p>
          <div class="wave gated">{bars.map((b) => <i style={`--h:${b.gated};--d:${b.d}s`}></i>)}</div>
        </div>
      </article>

      <!-- 3 volume -->
      <article class="row reveal">
        <div class="txt"><h3>{R[2].h}</h3>{R[2].p.map((t) => <p class="muted">{t}</p>)}</div>
        <div class="vis card">
          <div class="sl">
            <label for="mic">Phone: Mic boost <b class="mono" id="micOut">0 dB</b></label>
            <input id="mic" type="range" min="-12" max="12" step="1" value="0" data-slider data-out="micOut" data-warn="micWarn" />
            <span class="chip bad" id="micWarn" role="status" hidden>Too loud, limiting</span>
          </div>
          <div class="sl">
            <label for="tv">TV: Voice volume <b class="mono" id="tvOut">+3 dB</b></label>
            <input id="tv" type="range" min="-12" max="12" step="1" value="3" data-slider data-out="tvOut" data-warn="tvWarn" data-bar="tvBar" />
            <div class="meter" aria-hidden="true"><i id="tvBar"></i></div>
            <span class="chip warn" id="tvWarn" role="status" hidden>Voice limited</span>
          </div>
        </div>
      </article>

      <!-- 4 PIN -->
      <article class="row flip reveal">
        <div class="txt"><h3>{R[3].h}</h3>{R[3].p.map((t) => <p class="muted">{t}</p>)}</div>
        <div class="vis card">
          <div class="pin">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="var(--brand)" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            <span class="mono">482917</span>
          </div>
          <div class="lane ok" aria-hidden="true"><small>Your phone, right PIN</small><span class="trk"><i></i></span><em>Accepted</em></div>
          <div class="lane no" aria-hidden="true"><small>Other device, wrong PIN</small><span class="trk"><i></i></span><em>Dropped</em></div>
          <p class="sr">Your phone with the right PIN is accepted. A device with a wrong PIN is dropped.</p>
        </div>
      </article>

      <!-- 5 mode -->
      <article class="row reveal">
        <div class="txt"><h3>{R[4].h}</h3>{R[4].p.map((t) => <p class="muted">{t}</p>)}</div>
        <div class="vis card modes" data-mode-demo data-mode="hold">
          <fieldset>
            <legend class="sr">Talk mode</legend>
            <label><input type="radio" name="mode" value="hold" checked /><span>Hold to talk</span></label>
            <label><input type="radio" name="mode" value="keep" /><span>Keep talking</span></label>
          </fieldset>
          <button class="micbtn" type="button" data-mic>
            <svg viewBox="0 0 24 24" width="30" height="30" fill="#fff" aria-hidden="true"><path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2Z"/></svg>
          </button>
          <p class="mono" data-mic-label aria-live="polite">Hold to talk</p>
        </div>
      </article>

      <!-- 6 lives on TV -->
      <article class="row flip reveal">
        <div class="txt"><h3>{R[5].h}</h3>{R[5].p.map((t) => <p class="muted">{t}</p>)}</div>
        <div class="vis card">
          <Image class="shot" src={tvShot} widths={[480, 720, 1000]} sizes="(min-width: 900px) 520px, 90vw" alt="LAN Mic Receiver on a TV showing the phone address, a PIN, Receiving audio, delay, lost audio, Wi-Fi band and voice volume, with the text: Leave this app. It keeps running in the background, and an Exit button." loading="lazy" />
          <ul class="chips">
            <li class="chip">Starts when the TV boots</li><li class="chip">Runs in the background</li><li class="chip">Exit stops it</li>
          </ul>
        </div>
      </article>

      <!-- 7 stats -->
      <article class="row reveal">
        <div class="txt"><h3>{R[6].h}</h3>{R[6].p.map((t) => <p class="muted">{t}</p>)}</div>
        <div class="vis card">
          <div class="pair">
            <Image class="shot phone" src={phoneShot} widths={[320, 480]} sizes="(min-width: 900px) 200px, 40vw" alt="LAN Mic on a phone while live: delay about 73 ms (Good), network 11 ms, lost audio 0.0%, Hold to talk and Keep talking, Mic boost 0 dB." loading="lazy" />
            <Image class="shot" src={tvShot} widths={[480, 720]} sizes="(min-width: 900px) 300px, 55vw" alt="TV receiver stats: delay about 88 ms (Good), lost audio 0.0%, Wi-Fi 5 GHz, voice volume +3 dB." loading="lazy" />
          </div>
          <ul class="chips"><li class="chip good">Good</li><li class="chip warn">OK</li><li class="chip bad">Slow</li></ul>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import '../scripts/sliders.ts';
  import '../scripts/mode-toggle.ts';
</script>

<style>
  @property --n { syntax: '<integer>'; initial-value: 75; inherits: false; }
  .rows { display: grid; gap: clamp(48px, 8vw, 96px); }
  .row { display: grid; gap: var(--space-8); align-items: center; }
  .txt { display: grid; gap: var(--space-4); }
  .vis { display: grid; gap: var(--space-4); min-width: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .lab { font-size: 12px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.08em; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  @media (min-width: 900px) {
    .row { grid-template-columns: 1fr 1fr; gap: var(--space-12); }
    .flip .txt { order: 2; }
  }

  .count { font-size: clamp(48px, 8vw, 80px); line-height: 1; color: var(--brand); }
  .num { --n: 75; counter-reset: n var(--n); }
  .num::after { content: counter(n); }
  @supports (animation-timeline: view()) {
    .num { animation: cnt linear both; animation-timeline: view(); animation-range: entry 20% cover 45%; }
    @keyframes cnt { from { --n: 0; } to { --n: 75; } }
  }
  .seg { display: flex; gap: 3px; height: 40px; }
  .seg i { display: grid; align-items: center; padding: 0 8px; min-width: 0; background: var(--brand-tint); border-radius: 6px; overflow: hidden; }
  .seg i:nth-child(odd) { background: var(--surface-elevated); }
  .seg i:last-child { background: var(--brand-tint); }
  .seg b { font: 400 11px var(--font-mono); white-space: nowrap; overflow: hidden; text-overflow: clip; color: var(--text-primary); }
  .stat { display: grid; grid-template-columns: auto 1fr auto; gap: 6px var(--space-4); align-items: center; background: var(--app-bg); border-radius: var(--radius-md); padding: var(--space-4); color: var(--app-text); font-size: 14px; }
  .stat b { color: #fff; font-weight: 500; }

  .wave { display: flex; align-items: center; gap: 3px; height: 64px; }
  .wave i { flex: 1; height: calc(var(--h) * 1%); min-height: 2px; background: var(--text-secondary); border-radius: 2px; transform-origin: center; animation: pulse 1.4s ease-in-out var(--d) infinite alternate; }
  .gated i { background: var(--brand); }
  @keyframes pulse { from { transform: scaleY(0.75); } to { transform: scaleY(1); } }

  .sl { display: grid; gap: var(--space-2); }
  .sl label { display: flex; justify-content: space-between; font-weight: 500; }
  input[type='range'] { width: 100%; accent-color: var(--brand); height: 28px; }
  .meter { height: 6px; background: var(--surface-elevated); border-radius: 3px; overflow: hidden; }
  .meter i { display: block; height: 100%; background: var(--app-green); transform-origin: left; transform: scaleX(0.625); }

  .pin { display: flex; align-items: center; gap: var(--space-3); font-size: 28px; letter-spacing: 0.15em; }
  .lane { display: grid; grid-template-columns: 1fr; gap: 6px; font-size: 13px; }
  .lane small { color: var(--text-secondary); }
  .trk { position: relative; height: 10px; border-top: 2px dashed var(--border-default); }
  .trk i { position: absolute; top: -7px; left: 0; width: 10px; height: 10px; border-radius: 50%; background: var(--success-soft); animation: go 2.4s linear infinite; }
  .no .trk i { background: var(--error-soft); animation-name: stop; }
  .lane em { font-style: normal; font: 400 12px var(--font-mono); color: var(--success-soft); }
  .no em { color: var(--error-soft); }
  @keyframes go { from { transform: translateX(0); } to { transform: translateX(min(300px, 70vw)); } }
  @keyframes stop { 0% { transform: translateX(0); opacity: 1; } 60%, 100% { transform: translateX(min(150px, 35vw)); opacity: 0; } }

  .modes { justify-items: center; text-align: center; }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; gap: 4px; background: var(--surface-elevated); border-radius: var(--radius-full); padding: 4px; }
  fieldset label span { display: block; padding: 8px 16px; border-radius: var(--radius-full); cursor: pointer; font-weight: 500; font-size: 14px; }
  fieldset input { position: absolute; opacity: 0; }
  fieldset input:checked + span { background: var(--brand); color: var(--on-brand); }
  fieldset input:focus-visible + span { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .micbtn { width: 84px; height: 84px; border-radius: 50%; border: 0; background: #555; display: grid; place-items: center; cursor: pointer; transition: background 0.2s, transform 0.1s; }
  .micbtn[data-on] { background: var(--app-red); transform: scale(1.06); }

  .shot { width: 100%; height: auto; border-radius: var(--radius-md); box-shadow: var(--shadow-hairline); }
  .pair { display: grid; grid-template-columns: 38% 1fr; gap: var(--space-4); align-items: center; }
</style>
